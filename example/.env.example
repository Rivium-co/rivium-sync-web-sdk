# Read by the Vite dev server only (see vite.config.ts) and never bundled into
# the app. Copy this file to .env and fill it in.
#
# Your project's SERVER SECRET, from Rivium Console > project > settings. It can
# mint a token for any user, so it belongs on a server - never in an app.
RIVIUM_SYNC_SERVER_SECRET=rv_srv_xxx

# Optional overrides.
# RIVIUM_SYNC_API_KEY=rv_live_xxx        # defaults to the key in src/config.ts
# RIVIUM_SYNC_API_URL=https://sync.rivium.co
# RIVIUM_SYNC_DEMO_USER_ID=demo-user-1   # who this example signs in as
