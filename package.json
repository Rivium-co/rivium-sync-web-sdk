{
  "name": "@rivium/sync-web",
  "version": "0.2.0",
  "description": "Web SDK for RiviumSync - Firebase Realtime Database alternative with MQTT sync",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rivium_sync",
    "realtime-database",
    "mqtt",
    "websocket",
    "firebase-alternative",
    "realtime-sync",
    "offline-first"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rivium-co/rivium-sync-web-sdk.git"
  },
  "author": "Rivium",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rivium-co/rivium-sync-web-sdk/issues"
  },
  "homepage": "https://rivium.co/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rollup": "^4.0.0",
    "ts-jest": "^29.1.0",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "mqtt": "^5.0.0"
  }
}
